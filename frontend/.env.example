# Frontend'in backend'e ulaşacağı adres. Boş bırakılırsa Vite proxy (/api) kullanılır.
VITE_API_BASE_URL=/api/v1

# ---------- Gözlemlenebilirlik (opsiyonel) ----------
# Bu değerler boşken ilgili SDK bundle'a hiç girmez (dinamik import).
VITE_SENTRY_DSN=
VITE_SENTRY_SAMPLE_RATE=0.1

# PostHog yalnızca kullanıcı çerez onayı verdiyse başlatılır.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# ---------- E2E ----------
E2E_BASE_URL=http://localhost:4173
