# ---------- App ----------
APP_NAME=DocAssistant
ENVIRONMENT=local          # local | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# ---------- Database (PostgreSQL + pgvector) ----------
DATABASE_URL=postgresql+asyncpg://dev:dev@postgres:5432/docassistant

# ---------- Redis (cache + celery broker) ----------
REDIS_URL=redis://redis:6379/0

# ---------- Object Storage (MinIO local / S3 prod) ----------
STORAGE_BACKEND=local        # local | s3
STORAGE_LOCAL_DIR=./_storage
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=docassistant
S3_REGION=us-east-1

# ---------- Doküman yükleme ----------
MAX_UPLOAD_SIZE_MB=25
SIGNED_URL_EXPIRE_MINUTES=60
PROCESS_DOCUMENTS_EAGER=true   # false ise Celery worker'a devreder
ENABLE_OCR=false               # resim OCR için tesseract gerekir
# hashing: bagimliliksiz, kelime eslesmesi (anlam bilmez)
# ollama: nomic-embed-text ile anlamsal arama (onerilen)
# sentence_transformers: cevrimdisi, ~2GB torch gerektirir
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIM=384              # yalnizca hashing icin

# ---------- LLM (local Ollama; OpenAI fallback opsiyonel) ----------
LLM_PROVIDER=fake              # fake | ollama | openai
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
LLM_TIMEOUT_SECONDS=60
RAG_TOP_K=5
# OPENAI_API_KEY=sk-...     # fallback (opsiyonel)

# Model dosyalarinin birakildigi klasor (docker compose /models olarak baglar).
MODELS_DIR=/models
MODELS_MOUNT_PATH=/models
MODEL_IMPORT_TIMEOUT_SECONDS=600

# ---------- AI kotası (aylık token bütçesi) ----------
QUOTA_FREE_AI_TOKENS=100000
QUOTA_PRO_AI_TOKENS=2000000
QUOTA_BUSINESS_AI_TOKENS=20000000

# ---------- AI önbelleği & görevleri ----------
AI_CACHE_BACKEND=memory        # memory | redis
AI_CACHE_TTL_SECONDS=86400
AI_JOBS_EAGER=true             # false ise Celery worker'a devreder
AI_TASK_CONTEXT_CHARS=12000
AI_QUIZ_MAX_QUESTIONS=20

# ---------- Plan kotaları ----------
QUOTA_FREE_DOCUMENTS=10
QUOTA_PRO_DOCUMENTS=100
QUOTA_BUSINESS_DOCUMENTS=100000
QUOTA_FREE_STORAGE_MB=50
QUOTA_PRO_STORAGE_MB=1024
QUOTA_BUSINESS_STORAGE_MB=10240
QUOTA_FREE_AI_REQUESTS=100
QUOTA_PRO_AI_REQUESTS=1000
QUOTA_BUSINESS_AI_REQUESTS=10000

# ---------- Ödeme (Stripe) ----------
BILLING_PROVIDER=fake          # fake | stripe
BILLING_CURRENCY=USD
PRICE_PRO_MONTHLY=19
PRICE_BUSINESS_MONTHLY=99
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_pro_monthly
STRIPE_PRICE_BUSINESS=price_business_monthly
BILLING_SUCCESS_URL=http://localhost:5173/billing?status=success
BILLING_CANCEL_URL=http://localhost:5173/billing?status=cancel
BILLING_PORTAL_RETURN_URL=http://localhost:5173/billing

# ---------- Paylaşım, export ve pano ----------
SHARE_LINK_DEFAULT_EXPIRE_HOURS=168   # 7 gün
SHARE_LINK_MAX_EXPIRE_HOURS=720       # 30 gün
SHARE_PUBLIC_BASE_URL=http://localhost:5173/share
EXPORTS_EAGER=true                    # false ise Celery worker'a devreder
DASHBOARD_TREND_DAYS=30
ACTIVITY_LOG_PAGE_SIZE=50

# ---------- Güvenlik (Faz 7) ----------
# Hassas alanların AES-256-GCM anahtarı. Boşsa JWT_SECRET'ten türetilir.
# UYARI: değiştirilirse mevcut 2FA sırları çözülemez.
ENCRYPTION_KEY=
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000
AUDIT_LOG_SIGNING_ENABLED=true
LOG_PII_MASKING=true

# Rate limiting (çok süreçli dağıtımda backend=redis olmalı)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=memory      # memory | redis
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# ---------- Bildirimler (Faz 7) ----------
EMAIL_PROVIDER=console         # console | resend | sendgrid
EMAIL_FROM=DocAssistant <no-reply@docassistant.local>
# EMAIL_API_KEY boşken gönderim konsola düşer, gerçek mail gitmez.
EMAIL_API_KEY=
EMAIL_TIMEOUT_SECONDS=10
FRONTEND_BASE_URL=http://localhost:5173

# ---------- Gözlemlenebilirlik (Faz 7) ----------
# DSN boşsa Sentry tamamen devre dışı. Kurulum: pip install ".[observability]"
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
METRICS_ENABLED=true

# ---------- i18n & feature flags ----------
DEFAULT_LOCALE=tr              # tr | en
FEATURE_FLAGS=onboarding       # virgülle ayrılmış aktif flag listesi
