# ---------- App ----------
APP_NAME=DocAssistant
ENVIRONMENT=local          # local | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# ---------- Database (PostgreSQL + pgvector) ----------
DATABASE_URL=postgresql+asyncpg://dev:dev@postgres:5432/docassistant

# ---------- Redis (cache + celery broker) ----------
REDIS_URL=redis://redis:6379/0

# ---------- Object Storage (MinIO local / S3 prod) ----------
STORAGE_BACKEND=local        # local | s3
STORAGE_LOCAL_DIR=./_storage
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=docassistant
S3_REGION=us-east-1

# ---------- Doküman yükleme ----------
MAX_UPLOAD_SIZE_MB=25
SIGNED_URL_EXPIRE_MINUTES=60
PROCESS_DOCUMENTS_EAGER=true   # false ise Celery worker'a devreder
ENABLE_OCR=false               # resim OCR için tesseract gerekir
EMBEDDING_PROVIDER=hashing     # hashing | sentence_transformers
EMBEDDING_DIM=384

# ---------- LLM (local Ollama; OpenAI fallback opsiyonel) ----------
LLM_PROVIDER=fake              # fake | ollama | openai
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
# OPENAI_API_KEY=sk-...     # fallback (opsiyonel)
