# ---------- App ----------
APP_NAME=DocAssistant
ENVIRONMENT=local          # local | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# ---------- Database (PostgreSQL + pgvector) ----------
DATABASE_URL=postgresql+asyncpg://dev:dev@postgres:5432/docassistant

# ---------- Redis (cache + celery broker) ----------
REDIS_URL=redis://redis:6379/0

# ---------- Object Storage (MinIO local / S3 prod) ----------
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=docassistant
S3_REGION=us-east-1

# ---------- LLM (local Ollama; OpenAI fallback opsiyonel) ----------
LLM_PROVIDER=ollama        # ollama | openai
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
# OPENAI_API_KEY=sk-...     # fallback (opsiyonel)
